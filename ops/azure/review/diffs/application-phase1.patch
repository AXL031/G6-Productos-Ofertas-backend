+      GATEWAY_TAXONOMY_SVC_URL: await taxonomy.getUrl(),
+      GATEWAY_PUBLIC_OPERATION_IDS:
+        mode === 'PUBLIC_READ_ONLY' && gatewayEnabled ? operations : '',

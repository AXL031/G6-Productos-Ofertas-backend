# Isolated non-production pilot. No credentials belong in this file.
NODE_ENV=development
MESSAGING_PROVIDER=AZURE_SERVICE_BUS
G6_SERVICE_BUS_PILOT_ENABLED=true
SERVICE_BUS_NAMESPACE_FQDN=g6-pilot-example.servicebus.windows.net
# Pricing only, explicitly enabled; do not configure PRICING_AMQP_URL.
PRICING_PRICE_CHANGED_PUBLISH_ENABLED=true
# Retain each service's existing PostgreSQL TLS, G7 auth and port configuration.
# Audit must not configure PRICE_AUDIT_AMQP_URL.
# Production also requires G6_SECURITY_MODE=G7_AUTHENTICATED,
# G6_SERVICE_BUS_PRODUCTION_ENABLED=true and its exclusive AZURE_CLIENT_ID.
# This example does not authorize activation on shared workloads.
